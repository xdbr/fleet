TZ: Europe/Berlin
PAPERLESS_URL: https://dbr.paperless.barbara.bar
PAPERLESS_APP_TITLE: scanity
PAPERLESS_REDIS: redis://broker:6379
PAPERLESS_DBHOST: db
PAPERLESS_TASK_WORKERS: 4
# PAPERLESS_THREADS_PER_WORKER: 3
PAPERLESS_TIKA_ENABLED: 1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT: http://tika:9998
PAPERLESS_OCR_CLEAN: clean-final
PAPERLESS_OCR_DESKEW: true
PAPERLESS_OCR_ROTATE_PAGES: true
PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD: 9
PAPERLESS_CONSUMER_ENABLE_BARCODES: true
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE: true
PAPERLESS_CONSUMER_BARCODE_TIFF_SUPPORT: true
PAPERLESS_CONSUMER_BARCODE_RETAIN_SPLIT_PAGES: true
PAPERLESS_CONSUMER_ASN_BARCODE_PREFIX: "ASN-"
PAPERLESS_CONSUMER_BARCODE_UPSCALE: 2.5
PAPERLESS_DEBUG: true
