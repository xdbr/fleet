TZ: Europe/Berlin
PAPERLESS_BASE_URL: http://host.docker.internal:8000
MANUAL_TAG: paperless-gpt    # Optional, default: paperless-gpt
AUTO_TAG: paperless-gpt-auto # Optional, default: paperless-gpt-auto
# PAPERLESS_PUBLIC_URL: "http://localhost:8000" # Optional

# LLM Configuration - Option 3: Ollama (Local)
OLLAMA_HOST: http://10.0.0.2:11434

LLM_PROVIDER: ollama
LLM_MODEL: qwen3:8b  # "qwen3:0.6b" # qwen3:8b
TOKEN_LIMIT: 4096    # Recommended for smaller models: 1000
LLM_LANGUAGE: German # Optional, default: English

# OCR Configuration - Option 1: LLM-based OCR
OCR_PROVIDER: llm           # Default OCR provider
VISION_LLM_PROVIDER: ollama # openai or ollama
VISION_LLM_MODEL: minicpm-v
# VISION_LLM_MODEL: nanonets-ocr
# VISION_LLM_MODEL: benhaotang/Nanonets-OCR-s:latest

# OCR Processing Mode
OCR_PROCESS_MODE: image      # Optional, default: image, other options: pdf, whole_pdf
PDF_SKIP_EXISTING_OCR: false # Optional, skip OCR for PDFs with existing OCR

# Enhanced OCR Features
CREATE_LOCAL_HOCR: true    # Optional, save hOCR files locally
CREATE_LOCAL_PDF: true     # Optional, save enhanced PDFs locally
LOCAL_HOCR_PATH: /app/hocr # Optional, path for hOCR files
LOCAL_PDF_PATH: /app/pdf   # Optional, path for PDF files

PDF_UPLOAD: true                                 # Optional, upload enhanced PDFs to paperless-ngx
PDF_REPLACE: true                                # Optional and DANGEROUS, delete original after upload
PDF_COPY_METADATA: true                          # Optional, copy metadata from original document
PDF_OCR_TAGGING: true                            # Optional, add tag to processed documents
PDF_OCR_COMPLETE_TAG: paperless-gpt-ocr-complete # Optional, tag name

# Option 4: Docling Server
# OCR_PROVIDER: 'docling'                         # Use a Docling server
# DOCLING_URL: 'http://your-docling-server:port'  # URL of your Docling instance

# PAPERLESS_INSECURE_SKIP_VERIFY: false

AUTO_OCR_TAG: paperless-gpt-ocr-auto # Optional, default: paperless-gpt-ocr-auto
OCR_LIMIT_PAGES: 8                   # Optional, default: 5. Set to 0 for no limit.
LOG_LEVEL: debug                     # Optional: debug, warn, error
AUTO_GENERATE_TITLE: true
AUTO_GENERATE_TAGS: true
AUTO_GENERATE_CORRESPONDENTS: true
AUTO_GENERATE_CREATED_DATE: false
AUTO_GENERATE_CUSTOM_FIELD: true
PAPERLESS_CUSTOM_FIELD_WRITING_MODE: update # default: append, update, replace. default: append
